# ---------------------------------------------------------------------------
# Client environment. Copy to `.env` and fill in.
# Everything here is compiled into the app, so it must be PUBLIC-SAFE.
# Never put an LLM key or a service-role key in this file — those live in
# `supabase/.env` and are only ever read by edge functions.
# ---------------------------------------------------------------------------

# Supabase project (Project Settings -> API).
# Leave both blank to run the app fully on-device with no backend.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: a bare AI gateway URL, if you are not using Supabase Edge Functions.
# When blank the app calls the `ai-agent` function through the Supabase client.
EXPO_PUBLIC_AI_GATEWAY_URL=

# Model name shown in diagnostics. The server decides the real model.
EXPO_PUBLIC_AI_MODEL=gpt-4o-mini

# Build variant: development | staging | production
APP_VARIANT=production

# EAS project id — required only for push notifications and EAS builds.
EAS_PROJECT_ID=
