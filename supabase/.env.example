# Secrets for Supabase Edge Functions.
# Local dev:  supabase functions serve --env-file supabase/.env
# Production: supabase secrets set --env-file supabase/.env

# ---- LLM (OpenAI-compatible; swap the base URL for any other provider) ----
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# OPENAI_ORG=

# ---- Scheduler auth (used by pg_cron / external cron) ----
CRON_SECRET=generate-a-long-random-string

# ---- Push (optional: only needed for Expo push receipts on a paid plan) ----
# EXPO_ACCESS_TOKEN=

# ---- WhatsApp Business Cloud API (optional) ----
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_API_VERSION=v21.0

# ---- Pharmacy fulfilment partner (optional) ----
# PHARMACY_API_URL=
# PHARMACY_API_KEY=
